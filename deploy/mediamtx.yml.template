# Canonical mediamtx config for a single-box ArenaHub install — matches
# backend/config.py's Settings defaults (API 9997, HLS 8888, WebRTC 8889,
# SRT 8890) and the known-good layout in restore-mediamtx.sh. install.sh
# substitutes __SERVER_IP__ with the box's actual address (needed for
# WebRTC ICE candidates to resolve correctly from outside the LAN).
logLevel: info
logDestinations: [stdout]
readTimeout: 10s
writeTimeout: 10s
writeQueueSize: 512
udpMaxPayloadSize: 1472
api: yes
apiAddress: :9997
apiAllowOrigin: '*'
metrics: no
pprof: no
rtsp: yes
protocols: [multicast, tcp, udp]
rtspAddress: :8554
rtpAddress: :8000
rtcpAddress: :8001
rtmp: yes
rtmpAddress: :1935
hls: yes
hlsAddress: :8888
hlsVariant: lowLatency
hlsSegmentCount: 7
hlsSegmentDuration: 1s
hlsPartDuration: 200ms
hlsAllowOrigin: '*'
webrtc: yes
webrtcAddress: :8889
webrtcAllowOrigin: '*'
webrtcIPsFromInterfaces: yes
webrtcAdditionalHosts: [__SERVER_IP__]
webrtcLocalUDPAddress: :8889
srt: yes
srtAddress: :8890
paths:
  all:
    source: publisher
